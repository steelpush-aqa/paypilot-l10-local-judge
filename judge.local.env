# Локальний суддя через Ollama, у периметрі даних.
# Перевірено на qwen3.5:9b @ 56671c2ab938 станом на 2026-11-16 (AMD Ryzen 9 5950X, CPU-інференс).
#
# Цей файл - приклад без секретів. Локальний суддя НЕ використовує ANTHROPIC_API_KEY,
# тому ключа тут немає. Справжній .env у репозиторій не комітимо (див. .gitignore).

JUDGE_MODEL=ollama:qwen3.5:9b
JUDGE_BACKEND=ollama
JUDGE_FORMAT=schema            # schema|json|none. schema вмикає VERDICT_SCHEMA (constrained decoding на декодері)
OLLAMA_URL=http://host.docker.internal:11434
TEMP=0.7                       # збіг з умовами хмарного базового виміру, щоб порівняння було чесним

# JUDGE_TIMEOUT=180            # сек, за замовчуванням 180. Перший завантаж думаючої моделі буває повільним.
#
# Примітка: qwen3.5 - думаюча модель. У judge.py для неї зашито think:false,
# інакше модель палить токени на міркування і ламає JSON. Це не через env, а в коді.